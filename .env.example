# Marcel Agent starter environment
#
# Copy this file to .env, then replace placeholders with your own values.
# Keep .env private and never commit it. One model provider is required:
# configure exactly one provider key (for example OPENROUTER_API_KEY or
# FIREWORKS_API_KEY). See docs/reference/environment-variables.md for the
# complete variable catalog and provider-specific options.

# Required: choose one model provider (leave the others commented out).
# OPENROUTER_API_KEY=<your-openrouter-api-key>
# FIREWORKS_API_KEY=<your-fireworks-api-key>

# Optional Telegram gateway settings.
# TELEGRAM_BOT_TOKEN=<your-telegram-bot-token>
# TELEGRAM_ALLOWED_USERS=<comma-separated-telegram-user-ids>
# TELEGRAM_HOME_CHANNEL=<telegram-chat-id>
# TELEGRAM_WEBHOOK_URL=<https://your-host.example/telegram>
# TELEGRAM_WEBHOOK_PORT=<port>
# TELEGRAM_WEBHOOK_SECRET=<your-webhook-secret>

# Optional router/provider endpoint override.
# OPENROUTER_BASE_URL=<https://your-openrouter-compatible-endpoint/v1>