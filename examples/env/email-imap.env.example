# IMAP/SMTP email integration example.
# See docs/reference/environment-variables.md and website/docs/user-guide/messaging/email.md.
EMAIL_ADDRESS=<your-email-address>
EMAIL_PASSWORD=<your-email-app-password>
EMAIL_IMAP_HOST=<your-imap-host>
EMAIL_IMAP_PORT=<imap-port>
EMAIL_SMTP_HOST=<your-smtp-host>
EMAIL_SMTP_PORT=<smtp-port>
EMAIL_ALLOWED_USERS=<comma-separated-email-addresses>