# Google Workspace OAuth example.
# See docs/reference/environment-variables.md and website/docs/user-guide/skills/google-workspace.md.
GOOGLE_WORKSPACE_CLIENT_ID=<your-oauth-client-id>
GOOGLE_WORKSPACE_CLIENT_SECRET=<your-oauth-client-secret>
GOOGLE_WORKSPACE_REFRESH_TOKEN=<your-refresh-token>
GOOGLE_WORKSPACE_ACCESS_TOKEN=<your-access-token>
GOOGLE_WORKSPACE_TOKEN_EXPIRY=<token-expiry>
GOOGLE_WORKSPACE_SCOPES=<space-separated-oauth-scopes>